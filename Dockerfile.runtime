# The box an agent runtime works in — the generic image both @coder and @spec run from
# (`AGENT` picks which; @spec has no filesystem tools and just needs the cwd to exist).
#
# It holds a toolchain and nothing else — no source. `app/` arrives as a mount, so the
# image does not go stale every time the app changes, and rebuilding is only needed when
# the toolchain or the runtime's own dependencies move.
#
# What this is for: @coder has a shell, and a shell escapes every path rule the SDK can
# express. `cd` goes anywhere and redirection writes anywhere, so the approval card has
# been the only real boundary. This is the boundary that does not depend on someone
# reading a command carefully at 6pm.

FROM node:22-slim

# git is present now: @coder owns the implementation, and owning it means owning git (branch,
# commit, push). The old stance — no git binary, so history could never be touched — was for the
# model where @coder edited a repo mounted from the user's laptop and a human did the committing.
# The boundary has moved: git commands change things, so they route through the approval card like
# any other write, the push credential is scoped by the deployment (see GIT_TOKEN in main.ts), and
# what @coder may do to a branch is enforced by the repository's own protection rules — not by the
# binary's absence.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git \
  && rm -rf /var/lib/apt/lists/*

# The agent's own dependencies live in the image, separate from the app's. Installing them
# here rather than in the mount means the app's node_modules stays entirely the app's.
#
# `npm ci` and not `npm install`: the lockfile is what makes two builds of the same commit
# the same image. `install` floats to whatever published since, which is how this first
# failed — a patch release of the Agent SDK tightened its zod peer and the build broke
# without a line of this repo changing.
WORKDIR /agent
COPY packages/runtime/package.json packages/runtime/package-lock.json ./
RUN npm ci --omit=dev

COPY packages/runtime/ ./

# Never root. A container that runs as root and mounts your source is a smaller
# improvement over no container than it looks.
RUN chown -R node:node /agent
USER node

# /work/project is the project @coder implements into — the only mount and the only writable
# thing. The glossary is not on this filesystem in any form; it arrives as tool calls to the
# spec tool. (Override with APP_DIR if the project is mounted elsewhere.)
WORKDIR /work/project

ENV NODE_ENV=production
EXPOSE 5177
CMD ["node", "/agent/node_modules/.bin/tsx", "/agent/src/main.ts"]
