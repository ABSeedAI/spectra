{
  "name": "@abseed/spectra-drift-check",
  "version": "0.3.0",
  "description": "Offline drift check between a Spectra glossary and the code that implements it.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "lpezet",
  "homepage": "https://github.com/ABSeedAI/spectra/tree/main/packages/drift-check",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ABSeedAI/spectra.git",
    "directory": "packages/drift-check"
  },
  "keywords": [
    "spectra",
    "spec-driven",
    "glossary",
    "drift-check",
    "vitest"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
